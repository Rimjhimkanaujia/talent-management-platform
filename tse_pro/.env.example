# Copy this file to .env and fill in real values.
# .env is loaded automatically at startup (see config.py) if python-dotenv is installed.

# ---- Required for AI features (chat, exam generation/grading, gap analysis) ----
ANTHROPIC_API_KEY=

# ---- Email registration (SMTP) — sends new users their login ID + password ----
# If left blank, credentials are just shown once on-screen instead of emailed.
# TSE_SMTP_HOST=smtp.gmail.com
# TSE_SMTP_PORT=587
# TSE_SMTP_USER=youraddress@gmail.com
# TSE_SMTP_PASSWORD=your-app-password
# TSE_SMTP_FROM=youraddress@gmail.com
# TSE_SMTP_USE_TLS=true
# TSE_LOGIN_URL=http://127.0.0.1:8501

# ---- Optional overrides (defaults shown) ----
# TSE_DB_PATH=./talent_sphere.db
# TSE_MODEL=claude-sonnet-4-6
# TSE_PBKDF2_ITERATIONS=200000
# TSE_SEED_ADMIN_EMAIL=admin@talentsphere.com
# TSE_SEED_ADMIN_PASSWORD=admin123
# TSE_MIN_PASSWORD_LENGTH=8
# TSE_MAX_LOGIN_ATTEMPTS=5
# TSE_LOGIN_LOCKOUT_MINUTES=10
# TSE_CHUNK_WORDS=150
# TSE_CHUNK_OVERLAP=30
# TSE_DEFAULT_TOP_K=4
# TSE_LOG_LEVEL=INFO
# TSE_LOG_PATH=./app.log
